# 机器值仅在编排仓库根 .local.env 中覆盖；不执行 shell 展开。
SIM_NODE=
SIM_NAMESPACE=
LX_STACK_ID=
PUBLIC_ZENOHD_ROUTER=
SIM_L2_ROOT=simulation_projects/l2-simulator-amd64
SIM_L4_ROOT=station_projects/l4-agent
SIM_REGISTRY=
SIM_L2_IMAGE=image-registry/l2-uav-simulator-amd64-sim/amd64-ubuntu20.04-cuda0.0.0:latest
SIM_L3_IMAGE=image-registry/l3-dispatcher-planner-real/amd64-ubuntu20.04-cuda0.0.0:latest
SIM_FLUENT_IMAGE=image-registry/fluent-bit:3.1-amd64
SIM_RELAY_IMAGE=image-registry/l4-visualizer/lx-log-relay:amd64
SIM_ROS_MASTER_PORT=22311
SIM_UNITY_TCP_BIND=127.0.0.1
SIM_UNITY_TCP_HOST=127.0.0.1
SIM_UNITY_TCP_PORT=10000
SIM_UNITY_MODE=editor
SIM_UNITY_SENSOR_SOURCE=original
SIM_UNITY_PLAYER_PATH=
SIM_UNITY_SCENE_ID=local
SIM_UNITY_DEPTH_RANGE_M=5.0
SIM_UNITY_CAMERA_WIDTH=640
SIM_UNITY_CAMERA_HEIGHT=480
SIM_UNITY_CAMERA_VERTICAL_FOV=57.0
SIM_UNITY_CAMERA_TRANSLATION_FLU=0.15,0.0,0.1
SIM_GROUND_Z=
SIM_INITIAL_X=0.0
SIM_INITIAL_Y=0.0
SIM_INITIAL_Z=1.0
SIM_PYTHON_EXECUTABLE=/usr/bin/python3
SIM_READY_TIMEOUT_S=240
SIM_BUILD_TIMEOUT_S=1800
SIM_BUILD_MEMORY_MIB=8192
SIM_BUILD_JOBS=1
SIM_CAMERA_MAX_HZ=5
SIM_DEPTH_MAX_HZ=3
SIM_CLOUD_MAX_HZ=3
SIM_ODOM_MAX_HZ=10
SIM_TELEMETRY_MBIT=8
SIM_CLOUD_MAX_POINTS=20000
SIM_CLOUD_LEAF_M=0.15
