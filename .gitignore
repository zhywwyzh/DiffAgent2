# Unmanaged top-level l* directories remain independent repositories;
# l3-dispatcher-planner is the built-in tracked subtree of this repo (AGENTS.md).
/l*/
!l3-dispatcher-planner/
/lx-sim-k3s/
/diff-netbird/
!specs/l2/
!specs/l3/
!specs/l3/**/
!specs/l3/**/*.md
!specs/l4/
!specs/l4/log-visualizer/

# Build artifacts
.artifacts/
.state/
logs/
# Runtime ROS logs written by the sim stack hostPath mounts.
drone_projects/lx-ros-logs/

# Per-issue agent worktrees
.task-worktrees/

# Python / linter
.ruff_cache/
__pycache__/
*.pyc

.codex/
.zcode/

# Verified external bootstrap releases served only by diff-setup.
docker_registry/bootstrap/

# Host-local override env — the only private zone of this repo.
# NEVER commit: carries personal targets and credentials only.
# (The old wholesale .private/ zone was removed 2026-09-03.)
.local.env
gitlab-bots/.env

# codex
.codex/
