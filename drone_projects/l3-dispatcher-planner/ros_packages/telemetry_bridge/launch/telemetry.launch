<launch>
  <arg name="python_executable" default="python3"/>
  <arg name="config" default="/sim-config/telemetry.json"/>
  <node pkg="telemetry_bridge" type="telemetry_ros.py" name="telemetry_bridge" required="true" output="screen"
        launch-prefix="$(arg python_executable)">
    <param name="config" value="$(arg config)"/>
  </node>
</launch>
